# --- Real Slack (pick one) -------------------------------------------------
# Option 1: a bot token from your Slack app's "OAuth & Permissions" page
SLACK_BOT_TOKEN=

# Option 2: OAuth v2 with token rotation (`toolproof auth login`)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Slack requires HTTPS redirect URIs; front the local callback with a TLS tunnel (e.g. ngrok)
SLACK_REDIRECT_URI=https://localhost:8765/slack/oauth/callback
# SLACK_SCOPES=channels:read,groups:read,channels:history,groups:history,chat:write,reactions:write,users:read,users:read.email
# TOOLPROOF_TOKEN_PATH=~/.config/toolproof/slack-tokens.json

# --- Model providers for evals ----------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint works
GEMINI_API_KEY=
